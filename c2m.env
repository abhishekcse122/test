# Oracle Utilities C2M install configuration
# Fill in paths to vendor installers and environment-specific values

# --- General staging ---
STAGING_DIR=/u01/stage
WORK_DIR=/u01/c2m_work

# --- Java ---
# Path to a local Oracle/OpenJDK tar.gz. The script will extract it to JAVA_HOME's parent.
JDK_TARBALL=/u01/stage/jdk-11_linux-x64_bin.tar.gz
JAVA_HOME=/u01/jdk/jdk-11

# --- WebLogic Installer (Generic JAR) ---
# Example: /u01/stage/fmw_12.2.1.4.0_wls.jar or /u01/stage/fmw_14.1.1.0.0_wls.jar
WLS_JAR=/u01/stage/fmw_12.2.1.4.0_wls.jar

# Oracle inventory and Middleware homes
ORACLE_INVENTORY=/u01/app/oraInventory
MW_HOME=/u01/app/oracle/middleware
# WL_HOME will default to $MW_HOME/wlserver if not set
WL_HOME=

# --- WebLogic Domain ---
DOMAIN_HOME=/u01/app/oracle/user_projects/domains/c2m_domain
WL_ADMIN_USER=weblogic
WL_ADMIN_PASSWORD=ChangeMe_Admin1
WL_ADMIN_PORT=7001
# true|false
WL_PRODUCTION_MODE=true
WL_LISTEN_ADDRESS=

# --- JDBC / Database ---
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=ORCLPDB1
DB_APP_USER=C2M
DB_APP_PASSWORD=ChangeMe_DbUser1
DB_SYS_PASSWORD=ChangeMe_Sys1

# JDBC DataSource defaults (used by WLST configure step)
JDBC_DS_NAME=F1DataSource
JDBC_DS_JNDI=jdbc/F1DataSource
JDBC_DRIVER=oracle.jdbc.OracleDriver

# Optional vendor-provided DB installer/script (if available)
# e.g., /u01/stage/ouaf_db_installer/install.sh with response file
DB_INSTALLER=
DB_INSTALLER_RESPONSE=

# --- OUAF and C2M installers (place vendor media in STAGING_DIR) ---
# Accepts either a .sh or .jar installer plus response file (silent)
OUAF_INSTALLER=
OUAF_RESPONSE_FILE=

C2M_INSTALLER=
C2M_RESPONSE_FILE=

# Optional EAR to deploy (if generated by installers)
PRODUCT_EAR=

# --- OS users (created if missing) ---
WLS_OS_USER=weblogic
WLS_OS_GROUP=weblogic
DB_OS_USER=oracle
DB_OS_GROUP=oinstall

# --- Feature toggles (true|false) ---
INSTALL_OS_PREREQS=true
CREATE_OS_USERS=true
INSTALL_JDK=true
INSTALL_WLS=true
CREATE_WLS_DOMAIN=true
CONFIGURE_WLS_JDBC=false
INSTALL_OUAF=false
INSTALL_C2M=false
LOAD_DB=false
DEPLOY_APP=false

# --- Advanced ---
# Packages list can be tuned per distro
COMMON_RPMS="unzip zip tar ksh libaio libnsl which net-tools curl"
COMMON_DEBS="unzip zip tar ksh libaio1 libnsl-dev net-tools curl"