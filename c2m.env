# Oracle Utilities C2M install configuration
# Fill in paths to vendor installers and environment-specific values

# --- General staging ---
STAGING_DIR=/u01/stage
WORK_DIR=/u01/c2m_work

# --- Java ---
# Path to a local Oracle/OpenJDK tar.gz. The script will extract it to JAVA_HOME's parent.
JDK_TARBALL=/u01/stage/jdk-11_linux-x64_bin.tar.gz
JAVA_HOME=/u01/jdk/jdk-11

# --- WebLogic Installer (Generic JAR) ---
# Example: /u01/stage/fmw_12.2.1.4.0_wls.jar or /u01/stage/fmw_14.1.1.0.0_wls.jar
WLS_JAR=/u01/stage/fmw_12.2.1.4.0_wls.jar

# Oracle inventory and Middleware homes
ORACLE_INVENTORY=/u01/app/oraInventory
MW_HOME=/u01/app/oracle/middleware
# WL_HOME will default to $MW_HOME/wlserver if not set
WL_HOME=

# --- WebLogic Domain ---
DOMAIN_HOME=/u01/app/oracle/user_projects/domains/c2m_domain
WL_ADMIN_USER=weblogic
WL_ADMIN_PASSWORD=ChangeMe_Admin1
WL_ADMIN_PORT=7001
# true|false
WL_PRODUCTION_MODE=true
WL_LISTEN_ADDRESS=

# --- JDBC / Database ---
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=ORCLPDB1
DB_APP_USER=C2M
DB_APP_PASSWORD=ChangeMe_DbUser1
DB_SYS_PASSWORD=ChangeMe_Sys1

# JDBC DataSource defaults (used by WLST configure step)
JDBC_DS_NAME=F1DataSource
JDBC_DS_JNDI=jdbc/F1DataSource
JDBC_DRIVER=oracle.jdbc.OracleDriver

# Optional vendor-provided DB installer/script (if available)
# e.g., /u01/stage/ouaf_db_installer/install.sh with response file
DB_INSTALLER=
DB_INSTALLER_RESPONSE=

# --- OUAF and C2M installers (place vendor media in STAGING_DIR) ---
# Accepts either a .sh or .jar installer plus response file (silent)
OUAF_INSTALLER=
OUAF_RESPONSE_FILE=

C2M_INSTALLER=
C2M_RESPONSE_FILE=

# Optional EAR to deploy (if generated by installers)
PRODUCT_EAR=

# --- OS users (created if missing) ---
WLS_OS_USER=weblogic
WLS_OS_GROUP=weblogic
DB_OS_USER=oracle
DB_OS_GROUP=oinstall

# --- Feature toggles (true|false) ---
INSTALL_OS_PREREQS=true
CREATE_OS_USERS=true
INSTALL_JDK=true
INSTALL_WLS=true
CREATE_WLS_DOMAIN=true
CONFIGURE_WLS_JDBC=false
INSTALL_OUAF=false
INSTALL_C2M=false
LOAD_DB=false
DEPLOY_APP=false

# --- Advanced ---
# Packages list can be tuned per distro
COMMON_RPMS="unzip zip tar ksh libaio libnsl which net-tools curl"
COMMON_DEBS="unzip zip tar ksh libaio1 libnsl-dev net-tools curl"

# --- RCU (Repository Creation Utility) ---
RUN_RCU=false
# Path to rcu executable (usually under $MW_HOME/oracle_common/bin/rcu)
RCU_BIN=
RCU_PREFIX=C2M
RCU_COMPONENTS="STB OPSS IAU IAU_APPEND IAU_VIEWER MDS WLS"
# If left empty, will reuse DB_SYS_PASSWORD
RCU_SCHEMA_PASSWORD=

# --- Managed Server ---
CREATE_MANAGED_SERVER=true
MS_NAME=ManagedServer1
MS_LISTEN_ADDRESS=
MS_LISTEN_PORT=8001

# --- Node Manager / Machine ---
CONFIGURE_NODE_MANAGER=true
MACHINE_NAME=Machine1
NM_LISTEN_ADDRESS=
NM_LISTEN_PORT=5556
NM_TYPE=Plain
NM_HOME=
NM_ENROLL=true

# --- SSL for Managed Server ---
ENABLE_SSL_MANAGED=false
SSL_LISTEN_PORT=8002
KEYSTORES_MODE=CustomIdentityAndCustomTrust
IDENTITY_KEYSTORE_PATH=
IDENTITY_KEYSTORE_TYPE=JKS
IDENTITY_KEYSTORE_PASSWORD=
TRUST_KEYSTORE_PATH=
TRUST_KEYSTORE_TYPE=JKS
TRUST_KEYSTORE_PASSWORD=
HOSTNAME_VERIFICATION=false
USE_JSSE=true

# --- XML Registry ---
CONFIGURE_XML_REGISTRY=false
# Example entries (publicId|systemId|entityURI). Provide space-separated entries.
XML_REGISTRY_ENTRIES=""

# --- JVM Tuning for Managed Server ---
TUNE_JVM_MEMORY=true
MS_XMS=4g
MS_XMX=8g
EXTRA_SERVER_ARGS="-Dweblogic.debug.DebugMessaging=false"

# --- SPL Deployments ---
DEPLOY_SPL_APPS=false
SPLSERVICE_EAR=
SPLWEB_EAR=
DEPLOY_TARGETS=ManagedServer1
SPLSERVICE_ORDER=100
SPLWEB_ORDER=200

# --- Start Managed Server ---
START_MANAGED_SERVER=false
USE_NODEMANAGER=true

# --- Optional Oracle Utilities product installers ---
INSTALL_CCB=false
CCB_INSTALLER=
CCB_RESPONSE_FILE=

INSTALL_MDM=false
MDM_INSTALLER=
MDM_RESPONSE_FILE=

INSTALL_WAM=false
WAM_INSTALLER=
WAM_RESPONSE_FILE=

# --- Node Manager runtime ---
START_NODEMANAGER=false
NODEMANAGER_LOG_DIR=/u01/app/oracle/user_projects/nodemanager/logs